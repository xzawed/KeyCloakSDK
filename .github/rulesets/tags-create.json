{
  "name": "RELEASE-TAGS-CREATE",
  "target": "tag",
  "enforcement": "active",
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "always"
    }
  ],
  "conditions": {
    "ref_name": {
      "include": [
        "refs/tags/v*",
        "refs/tags/py-v*",
        "refs/tags/node-v*",
        "refs/tags/dotnet-v*",
        "refs/tags/php-v*",
        "refs/tags/rust-v*",
        "refs/tags/ruby-v*",
        "refs/tags/kotlin-v*"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "creation"
    }
  ]
}
