<!-- ⚠️ child.project.url.inherit.append.path="false" — 이게 없으면 Maven이 자식 모듈의 artifactId를
     부모의 URL 뒤에 **자동으로 덧붙인다**(maven-model-builder "Inheritance Assembly"의 기본 동작이며
     url·scm.connection·scm.developerConnection·scm.url·distributionManagement.site.url 5개가 대상).
     실측(`mvn -f java/keycloak-sdk-core/pom.xml help:effective-pom`)으로 keycloak-sdk-core의 유효 POM이
     이렇게 나오고 있었다:
       url        = https://github.com/xzawed/KeyCloakSDK/keycloak-sdk-core          (404)
       connection = scm:git:https://github.com/xzawed/KeyCloakSDK.git/keycloak-sdk-core  (clone 불가)
     즉 게시되는 4개 모듈 POM 전부가 **깨진 SCM URL**을 주장하게 된다 — 부정확한 URL보다 나쁘다.
     자식 POM에는 <url>/<scm>이 없어 눈에 띄지 않았고, 배포 산출물이 아니라 소비자 측 모델 빌드에서
     조립되므로 파일만 읽어서는 발견되지 않는다(반드시 effective-pom으로 확인할 것).
     quarkus·gson 등이 쓰는 것과 같은 표준 해법이다. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.xzawed</groupId>
  <artifactId>keycloak-sdk-parent</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Keycloak SDK (parent)</name>
  <description>Multi-language Keycloak SDK — Java reference implementation</description>
  <!-- <url>은 POM 레퍼런스상 "The project's home page" — 사람이 읽는 표시용 링크이지 VCS URL이 아니다
       (VCS는 아래 <scm>). 9개 언어 모노레포이므로 저장소 루트가 아니라 java/를 가리켜 소비자가
       Central에서 링크를 눌렀을 때 9개 언어 README가 아니라 java/README.md에 닿게 한다.
       Central 요구사항은 "presence"이고 resolvability는 검사하지 않는다. -->
  <url>https://github.com/xzawed/KeyCloakSDK/tree/main/java</url>

  <licenses>
    <license>
      <name>Apache-2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
    </license>
  </licenses>
  <developers>
    <developer><name>xzawed</name><email>xzawed31@gmail.com</email></developer>
  </developers>
  <!-- ⚠️ <scm>은 저장소 루트를 가리킨 채로 둔다 — connection/developerConnection은 사람이 읽는 링크가
       아니라 **VCS가 직접 물어야 하는 clone URL**이다. 모노레포라고 해서 여기에
       `/tree/main/java` 같은 경로를 넣으면 clone이 불가능해진다(위 project 주석의 실측 사례와 동일한
       종류의 파손). Maven에는 npm의 `repository.directory`에 해당하는 하위경로 필드가 없다.
       위 project 요소와 같은 이유로 append 억제 속성 3개를 명시한다. -->
  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <connection>scm:git:https://github.com/xzawed/KeyCloakSDK.git</connection>
    <developerConnection>scm:git:https://github.com/xzawed/KeyCloakSDK.git</developerConnection>
    <url>https://github.com/xzawed/KeyCloakSDK</url>
  </scm>

  <modules>
    <module>keycloak-sdk-bom</module>
    <module>keycloak-sdk-core</module>
    <module>keycloak-sdk-auth</module>
    <module>keycloak-sdk-admin</module>
    <module>keycloak-sdk</module>
    <module>keycloak-sdk-examples</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <keycloak.adminclient.version>26.0.12</keycloak.adminclient.version>
    <nimbus.oidc.version>11.38.2</nimbus.oidc.version>
    <nimbus.jose.version>10.9.1</nimbus.jose.version>
    <junit.version>6.1.3</junit.version>
    <mockito.version>5.23.0</mockito.version>
    <testcontainers.version>2.0.5</testcontainers.version>
    <testcontainers.keycloak.version>4.3.1</testcontainers.keycloak.version>
    <!-- 공개 API 파괴적 변경 게이트. 클래스가 없는 모듈(bom)과 소비자 API 가 아닌 모듈
         (examples)은 각 pom 에서 true 로 덮어 건너뛴다. -->
    <japicmp.skip>false</japicmp.skip>
    <!-- ⚠️ **직전 정식 릴리스**를 적는다(RC 가 아니다). 릴리스마다 함께 올린다. -->
    <japicmp.baseline>0.1.0</japicmp.baseline>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId><artifactId>junit-bom</artifactId>
        <version>${junit.version}</version><type>pom</type><scope>import</scope>
      </dependency>

      <!-- ⚠️ WBS 4.1 dependencyConvergence 핀: keycloak-admin-client 26.0.10의 전이 트리는
           keycloak-admin-client 자신이 직접 선언하는 Jackson 2.21.x 계열과, RESTEasy
           6.2.15.Final의 jackson2-provider가 재선언하는 구버전(Jackson 2.18.5,
           jboss-logging 3.5.3.Final 등)이 충돌한다. 각 아티팩트를 더 높은/
           keycloak-admin-client가 직접 선언한 버전으로 고정해 수렴시킨다.
           🔒 보안(2026-07-03 → 2026-07-08): jackson-databind 계열을 2.21.2 → 2.21.5로 상향해
           CVE-2026-54512/54513/54514/54516/54517/54518(다형성 검증 우회·SSRF·@JsonView/
           @JsonIgnore 우회) 6건 + CVE-2026-54515(GHSA-5jmj-h7xm-6q6v, 대소문자 무시 역직렬화가
           per-property @JsonIgnoreProperties 우회, 취약범위 <2.21.5)를 모두 해소한다. keycloak-client-
           parent:26.0.10 관리값(2.21.2)보다 높게 고정하는 "picked higher" 전략(수렴 유지). 2.21.5는
           2.21.x 라인의 CVE-2026-54515 fix로, 2026-07-08 Maven Central 출시 확인 후 상향(issue #8). -->
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-core</artifactId><version>2.22.2</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-databind</artifactId><version>2.22.2</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.core</groupId><artifactId>jackson-annotations</artifactId><version>2.22</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jdk8</artifactId><version>2.22.2</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.datatype</groupId><artifactId>jackson-datatype-jsr310</artifactId><version>2.22.2</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.jakarta.rs</groupId><artifactId>jackson-jakarta-rs-base</artifactId><version>2.22.2</version></dependency>
      <dependency><groupId>com.fasterxml.jackson.module</groupId><artifactId>jackson-module-jakarta-xmlbind-annotations</artifactId><version>2.22.2</version></dependency>
      <dependency><groupId>org.jboss.logging</groupId><artifactId>jboss-logging</artifactId><version>3.6.3.Final</version></dependency>
      <!-- jackson-databind 계열 6종은 CVE 대응으로 2.21.5(관리값 2.21.2보다 상향), jackson-annotations는
           별도 버전 트랙이라 2.21 유지(비취약), jboss-logging은 keycloak-client-parent:26.0.10 관리값과 일치. -->
      <!-- commons-io: 더 높은 버전으로 고정(picked higher) — keycloak-client-parent 등 권위 있는 BOM 출처 없음. -->
      <dependency><groupId>commons-io</groupId><artifactId>commons-io</artifactId><version>2.22.0</version></dependency>
      <!-- jakarta.activation-api: 더 높은 버전으로 고정(picked higher) — keycloak-client-parent 등 권위 있는 BOM 출처 없음. -->
      <dependency><groupId>jakarta.activation</groupId><artifactId>jakarta.activation-api</artifactId><version>2.1.4</version></dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- Apache-2.0 §4(a): 배포되는 모든 jar가 라이선스 전문을 담아야 한다. 여기 한 곳에서 상속시켜
         6개 모듈에 파일을 복사하지 않는다 — `${project.basedir}/..`는 각 모듈에서 `java/`로 해석되고
         `java/LICENSE`는 이미 저장소에 있다(루트 LICENSE와 동일 blob, 다른 8개 언어 디렉터리와 같은 관용).
         ⚠️ `<resources>`를 명시하면 Maven 기본값(src/main/resources)이 **대체**되므로 함께 재선언한다 —
         지금은 어느 모듈에도 없지만, 빠뜨리면 나중에 추가하는 모듈이 조용히 리소스를 잃는다.
         ⚠️ keycloak-sdk-bom은 packaging=pom이라 process-resources에 기본 바인딩이 없다 — 이 블록은
         상속되지만 실행되지 않아 BOM은 target/조차 만들지 않는다(현행 동작 유지). -->
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.basedir}/..</directory>
        <includes>
          <include>LICENSE</include>
        </includes>
        <targetPath>META-INF</targetPath>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <!-- Java 21 컴파일 재현성: 컴파일러 플러그인 버전을 명시 고정(Maven 기본값 드리프트 방지). -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId><version>3.15.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId><version>3.5.6</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.15</version>
        <configuration>
          <excludes>
            <exclude>**/*IT.class</exclude>
            <exclude>**/KeycloakContainerSupport.class</exclude>
            <!-- 라이브 네트워크 경계: 단위테스트 불가, Phase 6 통합테스트로 검증 (거버넌스 G3 주석) -->
            <exclude>**/AuthClient.class</exclude>
            <exclude>**/AdminClient.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution><id>prepare</id><goals><goal>prepare-agent</goal></goals></execution>
          <execution><id>report</id><phase>verify</phase><goals><goal>report</goal></goals></execution>
          <execution>
            <id>check</id><phase>verify</phase><goals><goal>check</goal></goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit><counter>LINE</counter><value>COVEREDRATIO</value><minimum>0.90</minimum></limit>
                    <limit><counter>BRANCH</counter><value>COVEREDRATIO</value><minimum>0.85</minimum></limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>3.6.3</version>
        <executions>
          <execution>
            <id>enforce</id><goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <dependencyConvergence/>
                <requireJavaVersion><version>[21,)</version></requireJavaVersion>
                <requireMavenVersion><version>[3.9,)</version></requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- ⚠️ 1.0 은 「파괴적 변경 없이는 major 를 올리지 않는다」는 약속이고, 지킬 수단 없이 하는
           약속은 이 저장소가 거절하는 부류다. rust cargo-semver-checks · python griffe ·
           go gorelease · dotnet Package Validation · php php-semver-checker 와 같은 자리다.
           ⚠️ **`oldVersion` 을 명시 핀한다 — 자동 추론에 맡기지 않는다.** 생략하고 실측했더니
           japicmp 가 **`0.1.0-RC1` 을 기준선으로 잡았다**(정식 `0.1.0` 이 아니라). 로컬 `.m2` 에
           RC 만 캐시돼 있었기 때문인데, 그 말은 **기준선이 환경에 따라 달라진다**는 뜻이다 —
           RC 대비 비교는 정식 대비보다 느슨하다. 릴리스마다 이 값을 올리는 비용을 택한다.
           낡으면 조용히 통과하지 않는다: 없는 좌표는 해석 실패로 빌드를 깬다. -->
      <plugin>
        <groupId>com.github.siom79.japicmp</groupId>
        <artifactId>japicmp-maven-plugin</artifactId>
        <version>0.26.1</version>
        <executions>
          <execution>
            <id>api-compat</id>
            <phase>verify</phase>
            <goals><goal>cmp</goal></goals>
          </execution>
        </executions>
        <configuration>
          <skip>${japicmp.skip}</skip>
          <oldVersion>
            <dependency>
              <groupId>${project.groupId}</groupId>
              <artifactId>${project.artifactId}</artifactId>
              <version>${japicmp.baseline}</version>
            </dependency>
          </oldVersion>
          <parameter>
            <!-- 바이너리 비호환이면 빌드를 깬다 — 리포트만 내고 통과하면 공허하다. -->
            <breakBuildOnBinaryIncompatibleModifications>true</breakBuildOnBinaryIncompatibleModifications>
            <breakBuildOnSourceIncompatibleModifications>true</breakBuildOnSourceIncompatibleModifications>
            <onlyModified>true</onlyModified>
          </parameter>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <!-- Maven Central(Central Portal) 배포 프로파일 (WBS 7.1). 로컬 검증:
       mvn -f java/pom.xml -Prelease -DskipTests -Dgpg.skip=true package
       실제 배포(mvn ... deploy)는 태그 드리븐 릴리스 CI(.github/workflows/release.yml, WBS 7.2)에서만
       수행하며 GPG 서명·Central Portal 토큰 시크릿이 필요하다(사람 승인 게이트). -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <!-- -sources.jar 첨부 -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.4.0</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- -javadoc.jar 첨부. ⚠️ Java 17+ javadoc은 엄격(doclint) — 문서 경고로 빌드가 실패하지
               않도록 doclint를 끄고 failOnError=false로 완화한다. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.12.0</version>
            <configuration>
              <doclint>none</doclint>
              <failOnError>false</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- 배포 아티팩트 GPG 서명 (verify 단계에 바인딩). 로컬/CI 검증 시 -Dgpg.skip=true로 생략. -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.8</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals><goal>sign</goal></goals>
              </execution>
            </executions>
          </plugin>
          <!-- Maven Central Portal 배포(구 OSSRH는 2025-06-30 종료, Central Portal 경로만 유효). -->
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- ⚠️ Maven Central은 게시 후 철회 수단이 전혀 없다. 이 SDK가 가진 유일한 회복
                   수단은 Central Portal의 사람 스테이징 단계 하나뿐이다 — 업로드가 staging에
                   머무는 동안에는 무비용으로 폐기할 수 있고, Publish를 누르는 순간 영구다.
                   `autoPublish`의 기본값은 false(수동 게시)이므로 지금도 안전하지만, 그 안전이
                   **플러그인 기본값 상속**에 의존하고 있었다. 기본값은 업그레이드로 바뀔 수 있고
                   그러면 아무 경고 없이 유일한 안전장치가 사라진다. 명시해 둔다. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
