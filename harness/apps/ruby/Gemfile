# frozen_string_literal: true

source "https://rubygems.org"

# Dockerfile이 리포 ruby/를 /src/ruby로 복사(빌드 컨텍스트 = 리포 루트).
gem "keycloak-sdk", path: "/src/ruby"
gem "faraday", "~> 2.0" # ROPC(app-local 헬퍼)용 — keycloak-sdk의 전이 의존성이나 명시 고정
gem "sinatra", "~> 4.0"
# ⚠️ **취약 구간이 둘이다.** CVE-2026-47736·47737(PROXY protocol v1)은 `>= 5.5.0, < 7.2.1` 과
# `>= 8.0.0, < 8.0.2` **두 구간**을 각각 영향받는다고 적는다(실측: 두 advisory 모두 동일).
# 즉 8.0.0(2026-04-09)·8.0.1(2026-04-26)은 7.2.1 보다 높은데도 취약하다 — `>= 7.2.1` 로 쓰면
# 그 창이 그대로 열린다. Gemfile 의 버전 제약은 단일 구간이라 두 패치 라인의 합집합
# (`[7.2.1,7.3) ∪ [8.0.2,∞)`)을 표현할 수 없으므로, 취약 버전을 하나도 포함하지 않는 하한
# `>= 8.0.2` 를 쓴다. 종전 `~> 6.4`(= >=6.4,<7.0)는 6.x 최신이 6.6.1 이라 어떤 패치에도 닿지 못했다.
# 상한 대신 화석화를 막는 것: 이 Gemfile 은 위의 `path: "/src/ruby"` 때문에 **dependabot 이 해석할
# 수 없어**(그 경로는 이미지 안에만 있다) 버전 업데이트 PR 이 오지 않는다 — 상한을 두면 아무도
# 올려주지 않아 이번과 같은 상태로 돌아간다. 부동(floating)의 대가인 재현성은 야간 하네스가 갚는다.
gem "puma", ">= 8.0.2"
gem "rackup", "~> 2.1"
