<?xml version="1.0" encoding="UTF-8"?>
<!--
  설치 검증 전용 settings.xml(java 참조 구현). Central은 그대로 유지한 채 mvn-repo 저장소를
  "추가"만 한다(리서치 부록 §java "<mirror>*</mirror> 금지 — 전이 의존성 Central 유지" 게차 준수).

  io.github.xzawed:* 좌표(keycloak-sdk-bom/keycloak-sdk-core/-auth/-admin/keycloak-sdk)는 mvn-repo에서
  해석되고, 전이 의존성(keycloak-admin-client·nimbus-*·jackson 등)은 publish/java.sh가 -Dmaven.repo.local로
  reactor 전체를 빌드할 때 함께 캐시돼 mvn-repo에도 존재하거나, 없으면 그대로 Central(기본 저장소, 이
  settings.xml이 건드리지 않음)에서 해석된다 — install-net은 실제 인터넷도 통과시키므로(격리 네트워크가
  아님) 두 경로 모두 성립한다.

  ⚠️ 게차(실측): maven:3.9-eclipse-temurin-21-alpine 이미지의 전역 settings.xml
  (${maven.home}/conf/settings.xml — `-s`는 사용자 settings만 바꾸고 전역엔 영향 없음)이 기본으로
  id="maven-default-http-blocker" mirrorOf="external:http:*" 미러를 심어 모든 평문 HTTP 외부
  저장소를 차단한다(HTTPS 강제 유도가 목적인 공식 이미지의 의도된 안전장치). mvn-repo는 이 하네스
  전용 평문 HTTP라 그대로면 "Blocked mirror" 오류로 해석이 실패한다 — 같은 id로 mirrorOf에
  `,!mvn-repo`를 추가해 우리 저장소 id만 예외로 빼는 것이 정정법이다(나머지 외부 HTTP 저장소는
  여전히 차단 — 이 사용자 settings.xml의 미러 항목이 id 일치로 전역 항목을 대체한다).
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>maven-default-http-blocker</id>
      <mirrorOf>external:http:*,!mvn-repo</mirrorOf>
      <name>Pseudo repository to mirror external repositories initially using HTTP (mvn-repo 예외).</name>
      <url>http://0.0.0.0/</url>
      <blocked>true</blocked>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>mvn-repo</id>
      <repositories>
        <repository>
          <id>mvn-repo</id>
          <url>http://mvn-repo/</url>
          <releases><enabled>true</enabled></releases>
          <snapshots><enabled>false</enabled></snapshots>
        </repository>
      </repositories>
    </profile>
  </profiles>
  <activeProfiles>
    <activeProfile>mvn-repo</activeProfile>
  </activeProfiles>
</settings>
