<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <!--
    설치 검증 quickstart 스모크 전용 pom(java 참조 구현) — harness/install/quickstart/java의
    QuickstartSmoke.java를 저장소 해석으로 설치된 keycloak-sdk에 대해 컴파일·실행한다. java/(SDK
    소스 트리)의 reactor에 속하지 않는 독립 프로젝트다(consume 이미지는 SDK 소스 트리에 접근하지 않음).

    소비자 관용 그대로: keycloak-sdk-bom을 import해 keycloak-sdk를 무버전으로 선언한다
    (리서치 부록 §java "소비자 POM은 keycloak-sdk-bom:0.1.0(import) + keycloak-sdk(무버전)").
  -->
  <modelVersion>4.0.0</modelVersion>
  <groupId>io.github.xzawed.harness</groupId>
  <artifactId>install-quickstart-java</artifactId>
  <version>0.0.1</version>
  <packaging>jar</packaging>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <exec.mainClass>io.github.xzawed.harness.quickstart.QuickstartSmoke</exec.mainClass>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.xzawed</groupId>
        <artifactId>keycloak-sdk-bom</artifactId>
        <version>0.1.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.xzawed</groupId>
      <artifactId>keycloak-sdk</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- `mvn compile exec:java`로 소스 컴파일→즉시 실행(소비자 클린 설치 후 "첫 프로그램 실행" 흉내). -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
      </plugin>
    </plugins>
  </build>
</project>
