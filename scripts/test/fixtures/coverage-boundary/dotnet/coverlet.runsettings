<?xml version="1.0" encoding="utf-8" ?>
<!-- 픽스처. <Exclude>[*]Sdk.Config</Exclude> 주석 속 필터는 세지 않는다 -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*]Sdk.AuthClient,[*]Sdk.Admin.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
