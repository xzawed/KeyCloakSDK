<?xml version="1.0" encoding="utf-8" ?>
<!-- 픽스처 — 실제 dotnet/coverlet.runsettings 와 같은 꼴(<Exclude> 타입 필터가 경계의 SSOT). -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*]Kc.AuthClient,[*]Kc.Admin.*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
