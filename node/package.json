{
  "name": "@xzawed/keycloak-sdk",
  "version": "0.1.0-rc.2",
  "description": "Keycloak SDK for Node.js/TypeScript — OIDC/OAuth2 authentication + Admin REST API, part of a nine-language polyglot SDK",
  "keywords": [
    "keycloak",
    "oidc",
    "oauth2",
    "openid-connect",
    "jwt",
    "authentication",
    "admin-api",
    "sdk",
    "typescript"
  ],
  "license": "Apache-2.0",
  "author": "xzawed <xzawed31@gmail.com>",
  "homepage": "https://github.com/xzawed/KeyCloakSDK/tree/main/node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzawed/KeyCloakSDK.git",
    "directory": "node"
  },
  "bugs": { "url": "https://github.com/xzawed/KeyCloakSDK/issues" },
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "sideEffects": false,
  "publishConfig": { "access": "public", "provenance": true },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test --no-error-on-unmatched-pattern",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage test/unit",
    "test:it": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@keycloak/keycloak-admin-client": "~26.7.0",
    "jose": "^6",
    "openid-client": "^6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@vitest/coverage-v8": "^3",
    "eslint": "^10",
    "prettier": "^3",
    "testcontainers": "^12",
    "typescript": "^6",
    "typescript-eslint": "^8",
    "vitest": "^3"
  }
}
