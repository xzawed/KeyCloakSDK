{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",

  // 직전 정식 릴리스의 타입 표면. `npm pack` 으로 받은 tarball 의 `dist/` 를 `dist-base/` 로
  // 풀어 둔다(CI 가 만든다 — `.gitignore` 에 있다).
  //
  // ⚠️ **커밋된 `.api.md` 를 기준선으로 쓰지 않는다** — kotlin 레인에서 BCV 를 기각한 것과 같은
  //    이유다. 커밋된 리포트는 개발자가 다시 뜨면 그만이라 「직전 게시본 대비」가 아니다.
  //    그래서 api-extractor 를 **두 번** 돌려 두 리포트를 만들고 그 둘을 비교한다.
  "mainEntryPointFilePath": "<projectFolder>/dist-base/index.d.ts",

  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/aeout/",
    "reportFileName": "base.api.md"
  },
  "docModel": { "enabled": false },
  "dtsRollup": { "enabled": false },

  // 게이트가 보는 것은 리포트 본문뿐이다. tsdoc 경고(`@` 이스케이프 등)로 실패시키지 않는다.
  "messages": {
    "extractorMessageReporting": { "default": { "logLevel": "none" } },
    "compilerMessageReporting": { "default": { "logLevel": "none" } }
  }
}
