<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Xzawed.Keycloak.Sdk</PackageId>
    <RootNamespace>Xzawed.Keycloak</RootNamespace>
    <AssemblyName>Xzawed.Keycloak.Sdk</AssemblyName>
    <Version>0.1.1</Version>
    <Description>Async-first Keycloak SDK for .NET — OIDC/OAuth2 authentication with hardened JWT validation, plus the Admin REST API, behind one facade. The .NET implementation of a nine-language polyglot Keycloak SDK (Java, Python, Node, Go, C#, PHP, Rust, Ruby, Kotlin).</Description>
    <PackageTags>keycloak;oidc;oauth2;admin;jwt</PackageTags>
    <!-- 공개 멤버 XML 문서 미작성 경고를 오류로 승격하지 않음(문서는 점진적으로) -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <!-- ⚠️ 1.0 은 「파괴적 변경 없이는 major 를 올리지 않는다」는 약속이고, 지킬 수단 없이 하는
         약속은 이 저장소가 거절하는 부류다. .NET 은 SDK 내장 Package Validation 이 그 수단이다 —
         별도 도구(ApiCompat CLI)를 들이지 않고 `dotnet pack` 이 **NuGet 의 기준선 패키지를 받아**
         공개 표면을 대조한다. rust `cargo-semver-checks` · python `griffe` · go `gorelease` 와 같은 자리. -->
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>0.1.1</PackageValidationBaselineVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Duende.IdentityModel" Version="8.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.22.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.22.0" />
    <PackageReference Include="Keycloak.AuthServices.Sdk" Version="2.7.0" />
    <!-- AddKeycloak DI extension needs IServiceCollection/AddSingleton (DI.Abstractions), NOT IHttpClientFactory.
         9.0.8 satisfies Keycloak.AuthServices.Sdk 2.7.0's transitive floor (>= 9.0.8); 9.0.x still supports net8.0. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.19" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Xzawed.Keycloak.Sdk.Tests" />
  </ItemGroup>
</Project>
